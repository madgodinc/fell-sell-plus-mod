<Application x:Class="FellSellPlus.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- MGI Studio palette (the look of MGI Stream Control / Hark / MGI Assistant). -->
    <Color x:Key="GroundC">#07060C</Color>
    <Color x:Key="C1">#FF6A3D</Color>
    <Color x:Key="C2">#FF3D9A</Color>
    <Color x:Key="C3">#FFC23D</Color>
    <SolidColorBrush x:Key="Ground" Color="#07060C"/>
    <SolidColorBrush x:Key="Glass" Color="#94161322"/>
    <SolidColorBrush x:Key="GlassHi" Color="#B8221D34"/>
    <SolidColorBrush x:Key="Well" Color="#8C08070E"/>
    <SolidColorBrush x:Key="Line" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="LineHi" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#F5F1FF"/>
    <SolidColorBrush x:Key="Dim" Color="#A59FBA"/>
    <SolidColorBrush x:Key="Faint" Color="#6C6682"/>
    <SolidColorBrush x:Key="Ok" Color="#2EE6B0"/>
    <SolidColorBrush x:Key="Bad" Color="#FF3D6E"/>
    <SolidColorBrush x:Key="Hot" Color="#FF6A3D"/>
    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF6A3D" Offset="0"/>
      <GradientStop Color="#FF3D9A" Offset="0.55"/>
      <GradientStop Color="#FFC23D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandV" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF6A3D" Offset="0"/>
      <GradientStop Color="#FF3D9A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fonts: static instances of Unbounded, Manrope and JetBrains Mono (OFL), by their legacy family names. -->
    <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Unbounded Medium</FontFamily>
    <FontFamily x:Key="DisplayBold">pack://application:,,,/Fonts/#Unbounded</FontFamily>
    <FontFamily x:Key="Text">pack://application:,,,/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="TextSemi">pack://application:,,,/Fonts/#Manrope SemiBold</FontFamily>
    <FontFamily x:Key="TextHeavy">pack://application:,,,/Fonts/#Manrope ExtraBold</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#JetBrains Mono Medium</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#F0161322"/>
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
      <Setter Property="FontFamily" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Round switch: a pill well with a knob that slides right and lights up in the brand gradient. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="48" Height="26">
                <Border x:Name="Track" CornerRadius="13" Background="#8C08070E" BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                <Border x:Name="Lit" CornerRadius="13" Background="{StaticResource Brand}" Opacity="0"/>
                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#A59FBA" HorizontalAlignment="Left" Margin="4,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="Slide" X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#55FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slider: thin well, brand-gradient fill up to the thumb, white thumb with a glow. -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20" Background="Transparent">
              <Ellipse Fill="#FF3D9A" Opacity="0.35" Width="20" Height="20"/>
              <Ellipse Fill="White" Width="12" Height="12"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FillRepeat" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Range" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24">
              <Border Height="6" CornerRadius="3" Background="#8C08070E" BorderBrush="#17FFFFFF" BorderThickness="1"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource FillRepeat}" Background="{StaticResource Brand}" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource FillRepeat}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text field: dark well, hairline border that lights up pink on focus. -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="CaretBrush" Value="#FF3D9A"/>
      <Setter Property="SelectionBrush" Value="#FF3D9A"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="10" Background="#8C08070E" BorderBrush="#2EFFFFFF" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#FF3D9A"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#B8221D34"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Main action: the brand gradient with a soft pink shadow. -->
    <Style x:Key="Go" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource DisplayBold}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="30,14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="G" RenderTransformOrigin="0.5,0.5">
              <Border CornerRadius="14" Background="{StaticResource Brand}">
                <Border.Effect><DropShadowEffect Color="#FF3D9A" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.45"/></Border.Effect>
              </Border>
              <Border CornerRadius="14" BorderThickness="0,1,0,0" BorderBrush="#73FFFFFF"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="G" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="G" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="G" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary action: glass pill. -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#F5F1FF"/>
      <Setter Property="FontFamily" Value="{StaticResource TextSemi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="999" Background="#94161322" BorderBrush="#2EFFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#B8221D34"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#FF3D9A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bare text button (reset, change folder). -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#A59FBA"/>
      <Setter Property="FontFamily" Value="{StaticResource TextSemi}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="C" TextBlock.Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="C" Property="TextBlock.Foreground" Value="#FF6A3D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window caption buttons. -->
    <Style x:Key="Cap" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#A59FBA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin scrollbar. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Background="#33FFFFFF" Margin="1,2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
