  {
   "section": "FellSellPlus_Console",
   "key": "ShowLoaderConsole",
   "type": "Boolean",
   "default": false,
   "description": "Show MelonLoader's black console window with the log. Off for players; the log is always in MelonLoader/Latest.log."
  },
  {
   "section": "FellSellPlus_Dev",
   "key": "SkipModules",
   "type": "String",
   "default": "",
   "description": "Developer bisect: comma-separated namespaces (e.g. Inventory,Shop) whose patches and ticks are disabled. Leave empty."
  },
  {
   "section": "FellSellPlus_Prayers",
   "key": "CardsPerStatue",
   "type": "Int32",
   "default": 3,
   "description": "How many prayers a statue offers (vanilla 3). More than 5 may not fit on screen.",
   "min": 1,
   "max": 8
  },
  {
   "section": "FellSellPlus_Prayers",
   "key": "MaxActivePrayers",
   "type": "Int32",
   "default": 5,
   "description": "Dungeon+ only: how many prayers you can hold before the game asks you to replace one (vanilla 5). Normal runs have no cap in the game.",
   "min": 1,
   "max": 20
  },
  {
   "section": "FellSellPlus_Challenge",
   "key": "Preset",
   "type": "String",
   "default": "Off",
   "description": "Baseline for every Challenge value: Off, Veteran, Nightmare, Blasphemous, Insane. Each key below is -1 by default (= take the preset); set a number to override it, easier or harder."
  },
  {
   "section": "FellSellPlus_Challenge",
   "key": "OnlyHarderLock",
