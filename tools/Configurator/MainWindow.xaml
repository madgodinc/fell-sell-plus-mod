<Window x:Class="FellSellPlus.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fell &amp; Sell Plus · Settings" Width="1440" Height="920" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Ground}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Icon="Art/mgi-mark.png">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <!-- Sky: breathing colour glows and rising embers (paused while the window is not active). -->
    <Canvas x:Name="Sky" IsHitTestVisible="False" ClipToBounds="True"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="76"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0" Margin="22,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Art/mgi-mark.png" Width="30" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="MGI" FontFamily="{StaticResource DisplayBold}" FontWeight="Bold" FontSize="17" Margin="10,0,0,0"
                     VerticalAlignment="Center" Foreground="{StaticResource Brand}"/>
          <Border Width="1" Height="18" Background="{StaticResource LineHi}" Margin="14,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ProductWord" FontFamily="{StaticResource Display}" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Templates (whole-mod presets) -->
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="999" Padding="5"
                Background="{StaticResource Glass}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel x:Name="Templates" Orientation="Horizontal"/>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Border x:Name="StatusPill" CornerRadius="999" Padding="12,7" Background="{StaticResource Glass}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="999" Padding="3" Margin="12,0,0,0" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel x:Name="LangSeg" Orientation="Horizontal"/>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
            <Button Style="{StaticResource Cap}" Click="Min_Click">
              <Path Data="M0,0 L11,0" Stroke="#A59FBA" StrokeThickness="1.4"/>
            </Button>
            <Button Style="{StaticResource Cap}" Click="Max_Click">
              <Path Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="#A59FBA" StrokeThickness="1.3"/>
            </Button>
            <Button Style="{StaticResource Cap}" Click="Close_Click">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#A59FBA" StrokeThickness="1.4"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Body -->
      <Grid Grid.Row="1" Margin="22,4,22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Section list -->
        <Border CornerRadius="18" Background="{StaticResource Glass}" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <DockPanel Margin="12">
            <Grid DockPanel.Dock="Top" Margin="2,2,2,12">
              <TextBox x:Name="Search" Style="{StaticResource Field}" FontFamily="{StaticResource Text}" Padding="34,8,10,8" TextChanged="Search_Changed"/>
              <Path Data="M5,0 A5,5 0 1 1 4.99,0 M8.6,8.6 L12,12" Stroke="#6C6682" StrokeThickness="1.6" Margin="13,0,0,0"
                    VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Foreground="{StaticResource Faint}" FontSize="13" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Index"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer x:Name="Scroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
          <StackPanel x:Name="Page" Margin="0,0,0,24"/>
        </ScrollViewer>
      </Grid>

      <!-- Bottom bar -->
      <Grid Grid.Row="2" Margin="22,0,22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Credit" FontFamily="{StaticResource Display}" FontSize="10.5" Foreground="{StaticResource Faint}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock x:Name="GameLabel" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="BrowseBtn" Style="{StaticResource Link}" Margin="12,0,0,0" Click="Browse_Click"/>
            <Button x:Name="RestoreBtn" Style="{StaticResource Link}" Margin="16,0,0,0" Click="Restore_Click"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Status" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource TextSemi}" FontSize="13" Foreground="{StaticResource Dim}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ResetBtn" Style="{StaticResource Ghost}" Click="ResetSection_Click" Margin="0,0,12,0"/>
          <Button x:Name="SaveBtn" Style="{StaticResource Go}" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
