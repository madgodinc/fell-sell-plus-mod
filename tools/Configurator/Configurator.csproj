<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FellSellPlusConfigurator</AssemblyName>
    <RootNamespace>FellSellPlus.Configurator</RootNamespace>
    <ApplicationIcon>Art\mgi.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>MGI (Mad God Inc)</Company>
    <Authors>MGI</Authors>
    <Product>Fell &amp; Sell Plus Configurator</Product>
    <!-- Runs on any newer installed Windows Desktop runtime (Mad has .NET 10 only). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Art\mgi-mark.png" />
    <EmbeddedResource Include="Resources\schema.json" LogicalName="schema.json" />
    <EmbeddedResource Include="Resources\texts.json" LogicalName="texts.json" />
  </ItemGroup>
  <!-- Fallback schema from the mod sources, so the app knows every setting before the game ran.
       Needs Python; if it is missing the committed Resources/schema.json is used as is. -->
  <Target Name="GenSchema" BeforeTargets="BeforeBuild">
    <Exec Command="python -I gen_schema.py ../../src/FellSellPlus Resources/schema.json" ContinueOnError="true" />
  </Target>
</Project>
